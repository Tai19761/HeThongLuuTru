spring.application.name=master-node
 
 # Chỉ đến database đã tạo
 spring.datasource.url = jdbc:postgresql://localhost:5432/master_db
 
 # Ten dang nhap va mat khau database
 spring.datasource.username = postgres
 spring.datasource.password = YOUR_DB_PASSWORD
 
 

 spring.jpa.hibernate.ddl-auto = update
 spring.jpa.properties.hibernate.dialect =org.hibernate.dialect.PostgreSQLDialect
 spring.jpa.show-sql = true
 
 server.port = 8000
 
 # Giới hạn kích thước cho một file đơn lẻ
spring.servlet.multipart.max-file-size=500MB
# Giới hạn tổng kích thước của toàn bộ gói request
spring.servlet.multipart.max-request-size=500MB
